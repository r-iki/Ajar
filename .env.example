# ==============================================================================
# Ajar LMS - Environment Configuration Example
# Copy this file to .env.local and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NODE_ENV=development

# Optional branding & signer customizations
NEXT_PUBLIC_BRAND_NAME="Ajar LMS"
NEXT_PUBLIC_SIGNER_NAME="Lead Instructor"
NEXT_PUBLIC_SIGNER_TITLE="CEO & Founder"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_SUPPORT_PHONE="+62 800-0000-0000"
NEXT_PUBLIC_COMPANY_ADDRESS="Bandung, Indonesia"

# Multi-domain & local tunnel development origins (comma-separated, optional)
COOKIE_DOMAIN=
TRUSTED_ORIGINS=
ALLOWED_DEV_ORIGINS=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/ajar_dev?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random secret (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-string-min-32-chars

# Google OAuth & Google One Tap (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. Email Services (Resend & Optional Cloudflare Worker)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ajar Support <no-reply@example.com>"
RESEND_TO_EMAIL="support@example.com"
CF_WORKER_URL=
NEXT_PUBLIC_CF_WORKER_URL=

# ------------------------------------------------------------------------------
# 5. Payment Gateways
# ------------------------------------------------------------------------------
# DOKU (Jokul - Primary Gateway for Indonesia: QRIS, VA, E-Wallet, Card)
NEXT_PUBLIC_ENABLE_DOKU=true
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false

# Stripe (Optional International Gateway: Credit / Debit Cards)
NEXT_PUBLIC_ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. Object Storage (Cloudflare R2 / S3 Compatible)
# ------------------------------------------------------------------------------
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
